<header>
  <div class="nav-container">
    <h1 class="site-title"><%= title %></h1>
    <nav>
      <div class="nav-toggle" id="nav-toggle">&#9776;</div>
        <ul class="nav-menu" id="nav-menu">
        <li>
            <% if(page === 'index'){ %>
            <span class="active">Home</span>
            <% } else { %>
            <a href="/">Home</a>
            <% } %>
        </li>

        <li>
            <% if(page === 'map'){ %>
            <span class="active">Map</span>
            <% } else { %>
            <a href="/map">Map</a>
            <% } %>
        </li>

        <li>
            <% if(page === 'schedule'){ %>
            <span class="active">Schedule</span>
            <% } else { %>
            <a href="/schedule">Schedule</a>
            <% } %>
        </li>

        <li>
          <% if(page === 'favorites'){ %>
            <span class="active">Favorites</span>
          <% } else { %>
            <a href="/favorites">Favorites</a>
          <% } %>
        </li>

        <li>
            <% if(page === 'admin'){ %>
            <span class="active">Tracer</span>
            <% } else { %>
            <a href="/admin">Tracer</a>
            <% } %>
        </li>

        <li>
            <% if(page === 'about'){ %>
            <span class="active">About</span>
            <% } else { %>
            <a href="/about">About</a>
            <% } %>
        </li>

        <%
          // Whether someone is signed in is a fact the SERVER already knows --
          // req.session.user is what gates /map and /favorites. This used to be
          // decided client-side from localStorage instead, so a signed-in user
          // whose localStorage had been cleared saw a "Login" link that bounced
          // them straight back to a page they already had access to.
        %>
        <li id="authLink">
          <% if (typeof user !== "undefined" && user) { %>
            <a href="#" id="logoutBtn">Log out</a>
          <% } else { %>
            <a href="/auth/login" class="<%= page === 'login' ? 'active' : '' %>">Login</a>
          <% } %>
        </li>

        </ul>

    </nav>
  </div>
</header>

<script src="/js/menu.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const logoutBtn = document.getElementById('logoutBtn');
    if (!logoutBtn) return;
    logoutBtn.addEventListener('click', async (e) => {
      e.preventDefault();
      try { localStorage.removeItem('user'); } catch { /* private mode */ }
      await fetch('/auth/sessionLogout', { method: 'POST' });
      window.location.href = '/';
    });
  });
</script>
