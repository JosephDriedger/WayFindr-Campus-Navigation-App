<header>
  <div class="nav-container">
    <h1 class="site-title"><%= title %></h1>
    <nav>
      <div class="nav-toggle" id="nav-toggle">&#9776;</div>
        <ul class="nav-menu" id="nav-menu">
        <li>
            <% if(page === 'index'){ %>
            <span class="active">Home</span>
            <% } else { %>
            <a href="/">Home</a>
            <% } %>
        </li>

        <li>
            <% if(page === 'map'){ %>
            <span class="active">Map</span>
            <% } else { %>
            <a href="/map">Map</a>
            <% } %>
        </li>

        <li>
            <% if(page === 'schedule'){ %>
            <span class="active">Schedule</span>
            <% } else { %>
            <a href="/schedule">Schedule</a>
            <% } %>
        </li>

        <li>
          <% if(page === 'favorites'){ %>
            <span class="active">Favorites</span>
          <% } else { %>
            <a href="/favorites">Favorites</a>
          <% } %>
        </li>

        <%
          // The maintenance pages, behind one heading rather than spread
          // across the bar: there are three of them now and they are one job,
          // done by a few people, while everything to the left is the app
          // everybody uses. They refuse anyone who is not an administrator, so
          // for everyone else this is a heading to pages that turn them away
          // and it is not drawn at all. isAdmin is set for every render in
          // server.js.
          //
          // A <details> rather than a scripted menu: it opens on click and on
          // Enter, closes on Escape, and works before any JavaScript loads.
          const adminPages = ['admin', 'tracer', 'plans', 'users'];
          const inAdmin = adminPages.indexOf(page) !== -1;
        %>
        <% if (typeof isAdmin !== "undefined" && isAdmin) { %>
        <li class="nav-dropdown">
          <details>
            <%# open on click only: the submenu hangs over the page, so one
                that opened itself on every admin page would cover the top of
                whatever you came to look at %>
            <summary class="<%= inAdmin ? 'active' : '' %>">Admin</summary>
            <ul class="nav-submenu">
              <li><a href="/admin"<%= page === 'admin' ? ' aria-current="page"' : '' %>>Dashboard</a></li>
              <li><a href="/admin/tracer"<%= page === 'tracer' ? ' aria-current="page"' : '' %>>Floor Plan Tracer</a></li>
              <li><a href="/admin/plans"<%= page === 'plans' ? ' aria-current="page"' : '' %>>Floor Plans</a></li>
              <li><a href="/admin/users"<%= page === 'users' ? ' aria-current="page"' : '' %>>People</a></li>
            </ul>
          </details>
        </li>
        <% } %>

        <li>
            <% if(page === 'about'){ %>
            <span class="active">About</span>
            <% } else { %>
            <a href="/about">About</a>
            <% } %>
        </li>

        <%
          // Whether someone is signed in is a fact the SERVER already knows --
          // req.session.user is what gates /map and /favorites. This used to be
          // decided client-side from localStorage instead, so a signed-in user
          // whose localStorage had been cleared saw a "Login" link that bounced
          // them straight back to a page they already had access to.
        %>
        <li id="authLink">
          <% if (typeof user !== "undefined" && user) { %>
            <a href="#" id="logoutBtn">Log Out</a>
          <% } else { %>
            <a href="/auth/login" class="<%= page === 'login' ? 'active' : '' %>">Login</a>
          <% } %>
        </li>

        </ul>

    </nav>
  </div>
</header>

<script src="/js/menu.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const logoutBtn = document.getElementById('logoutBtn');
    if (!logoutBtn) return;
    logoutBtn.addEventListener('click', async (e) => {
      e.preventDefault();
      try { localStorage.removeItem('user'); } catch { /* private mode */ }
      await fetch('/auth/sessionLogout', { method: 'POST' });
      window.location.href = '/';
    });
  });
</script>
