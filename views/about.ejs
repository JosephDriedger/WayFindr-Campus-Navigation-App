<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('_menu', { page: 'about' }) %>

  <main class="about">
    <div class="about-content">
      <h2>About Campus Map Navigator</h2>
      <p>
        Wayfindr helps BCIT students, faculty and visitors find their way around the
        Burnaby campus. Search for a room, see it drawn on its floor plan, and get a
        walking route to it -- indoors as well as out. The floor plans are generated
        from BCIT's own published drawings.
      </p>

      <h3>Our Team</h3>
      <div class="team">
        <div class="team-member">
          <h4>Joey Driedger</h4>
          <p>Mapbox Development & Design</p>
        </div>
        <div class="team-member">
          <h4>Adam Van Woerden</h4>
          <p>Backend, API Integration, & Documentation</p>
        </div>
        <div class="team-member">
          <h4>Keagan P</h4>
          <p>Node Creation & Navigation Management</p>
        </div>
        <div class="team-member">
          <h4>John Guo</h4>
          <p>Interior Navigation & Map Generation</p>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
